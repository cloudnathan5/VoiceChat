{
  "name": "voicechat",
  "version": "1.0.0",
  "description": "Low-latency speech conversations with any OpenAI-compatible text model, entirely in the browser",
  "type": "module",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "build:demo": "cd frontend && npm run build:demo",
    "preview": "cd frontend && npm run preview",
    "test": "node --test frontend/src/lib/*.test.js",
    "test:e2e": "node scripts/e2e-demo.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.96.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "playwright": "^1.60.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.3"
  }
}
